<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BuyTicketActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ticketAdd"
        android:layout_width="383dp"
        android:layout_height="735dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/image_slider_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <EditText
            android:id="@+id/ticketQuantity"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ems="10"
            android:fontFamily="@font/robotocondensed"
            android:hint="Ticket Quatity"
            android:inputType="number"
            android:textAlignment="center"
            android:textColorHint="@color/error"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/ticketLocation"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="@+id/ticketLocation"
            app:layout_constraintTop_toBottomOf="@+id/ticketPrice" />

        <EditText
            android:id="@+id/ticketTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:cursorVisible="false"
            android:editable="false"
            android:ems="10"
            android:fontFamily="@font/robotocondensed"
            android:hint="Event Time"
            android:inputType="text"
            android:textAlignment="center"
            android:textColorHint="@color/white"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/ticketLocation"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/ticketLocation"
            app:layout_constraintTop_toBottomOf="@+id/ticketLocation" />

        <ImageView
            android:id="@+id/ticketImage"
            android:layout_width="340dp"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ticketName"
            app:srcCompat="@drawable/image_slider_4" />

        <TextView
            android:id="@+id/ticketName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:cursorVisible="false"
            android:editable="false"
            android:fontFamily="@font/robotocondensed"
            android:hint="Event Name"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textColorHint="@color/white"
            android:textSize="30sp"
            app:layout_constraintEnd_toEndOf="@+id/ticketImage"
            app:layout_constraintStart_toStartOf="@+id/ticketImage"
            app:layout_constraintTop_toTopOf="parent" />

        <EditText
            android:id="@+id/ticketPrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:cursorVisible="false"
            android:editable="false"
            android:ems="10"
            android:fontFamily="@font/robotocondensed"
            android:hint="Ticket Price"
            android:inputType="number"
            android:textAlignment="center"
            android:textColorHint="@color/white"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/ticketImage"
            app:layout_constraintStart_toStartOf="@+id/ticketImage"
            app:layout_constraintTop_toBottomOf="@+id/ticketImage" />

        <EditText
            android:id="@+id/ticketLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:cursorVisible="false"
            android:editable="false"
            android:ems="10"
            android:fontFamily="@font/robotocondensed"
            android:hint="Event Location"
            android:inputType="text"
            android:textAlignment="center"
            android:textColorHint="@color/white"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/ticketPrice"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/ticketPrice"
            app:layout_constraintTop_toBottomOf="@+id/ticketQuantity" />

        <EditText
            android:id="@+id/ticketDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:cursorVisible="false"
            android:editable="false"
            android:ems="10"
            android:fontFamily="@font/robotocondensed"
            android:hint="Event Date"
            android:inputType="text"
            android:textAlignment="center"
            android:textColorHint="@color/white"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/ticketLocation"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@+id/ticketLocation"
            app:layout_constraintTop_toBottomOf="@+id/ticketTime" />

        <EditText
            android:id="@+id/ticketBookingDate"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:cursorVisible="false"
            android:editable="false"
            android:ems="10"
            android:fontFamily="@font/robotocondensed"
            android:hint="Event Ending Date"
            android:inputType="text"
            android:textAlignment="center"
            android:textColorHint="@color/white"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="@+id/ticketDate"
            app:layout_constraintStart_toEndOf="@+id/textView10"
            app:layout_constraintTop_toBottomOf="@+id/ticketDate" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/buyButton"
            style="@android:style/Widget.Button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/success_alert_bg"
            android:text="Buy Ticket"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ticketBookingDate" />

        <TextView
            android:id="@+id/textView10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/robotocondensed_bold"
            android:text="End Date"
            android:textColor="@color/error"
            android:textSize="30sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/ticketBookingDate"
            app:layout_constraintStart_toStartOf="@+id/ticketDate"
            app:layout_constraintTop_toBottomOf="@+id/ticketDate" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>